# Local/dev environment variables for docker-compose
# IMPORTANT: Replace POSTGRES_PASSWORD before running on an exposed machine.

POSTGRES_USER=filevault_user
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_DB=filevault_db
POSTGRES_PORT=5432

# Backend settings
BACKEND_PORT=8080
BASE_URL=http://localhost:8080
FILE_BASE_PATH=/data/files

# Frontend settings
FRONTEND_PORT=3000
VITE_API_BASE=http://localhost:8080
VITE_GQL_ENDPOINT=http://localhost:8080/query

###
# Note:
# - Do NOT commit real secrets to the repo. Use GitHub Secrets and CI secrets for production.